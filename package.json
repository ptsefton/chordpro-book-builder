{
  "name": "chordpro-book-builder",
  "version": "0.1.0",
  "description": "Browser app (and CLI) that turns a folder of ChordPro songs and Markdown setlists into a standalone, printable songbook page, via an RO-Crate.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "generate:chordprobook-bundle": "node scripts/bundle-chordprobook-for-browser.mjs",
    "fix:st-directive": "node scripts/fix-st-directive.mjs",
    "build:songbook": "node src/chordpro-input/build-songbook.mjs",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/build-site.mjs --serve"
  },
  "dependencies": {
    "chordprobook": "github:ptsefton/chordprobook-js#main",
    "jszip": "^3.10.1",
    "ro-crate": "^3.7.2"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "yaml": "^2.9.0"
  },
  "private": true
}
